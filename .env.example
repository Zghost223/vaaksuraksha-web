# VaakSuraksha Environment Variables
# Copy this file to .env.local and fill in your values

# Database (Vercel Postgres, Neon, Supabase, or local PostgreSQL)
# Format: postgresql://user:password@host:port/database
POSTGRES_URL="postgresql://vaaksuraksha:password@localhost:5432/vaaksuraksha"

# Alternative: Use individual components if your provider gives them
# POSTGRES_HOST="localhost"
# POSTGRES_PORT="5432"
# POSTGRES_DB="vaaksuraksha"
# POSTGRES_USER="vaaksuraksha"
# POSTGRES_PASSWORD="password"

# Application
NEXT_PUBLIC_APP_URL="https://vaaksuraksha.vercel.app"
NODE_ENV="production"

# Optional: Redis for session state (if using Redis)
# REDIS_URL="redis://localhost:6379"

# Optional: External API keys (for production integrations)
# TELEPHONY_PROVIDER_API_KEY=""
# SMS_PROVIDER_API_KEY=""
# EMAIL_PROVIDER_API_KEY=""

# Feature flags
NEXT_PUBLIC_ENABLE_DASHBOARD="true"
NEXT_PUBLIC_ENABLE_ACCURACY="true"
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"